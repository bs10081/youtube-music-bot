{
  "name": "youtube-music-bot",
  "version": "0.13.0",
  "description": "YouTube Music 點歌機器人 WebUI",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "bun build src/index.ts --outfile dist/index.js --target bun && bun build scripts/check-playback.ts --outfile dist/check-playback.js --target bun",
    "build:frontend": "cd frontend && npm run build",
    "build:all": "npm run build:frontend && npm run build",
    "start": "NODE_ENV=production bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/__tests__",
    "test:watch": "bun test src/__tests__ --watch",
    "check:playback": "bun run scripts/check-playback.ts"
  },
  "dependencies": {
    "hono": "^4.13.7",
    "ws": "^8.21.3",
    "youtubei.js": "18.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
